<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>CampusConnect Issue Report</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f7f9ff;
      color: #26324a;
    }

    .container {
      width: min(1100px, 92%);
      margin: 40px auto;
    }

    .header {
      background: white;
      padding: 28px;
      border-radius: 20px;
      margin-bottom: 24px;
      box-shadow: 0 10px 30px rgba(50, 70, 120, 0.08);
    }

    .header h1 {
      margin: 0 0 8px;
      font-size: 30px;
    }

    .header p {
      margin: 0;
      color: #69758d;
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .summary-card {
      background: white;
      padding: 20px;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(50, 70, 120, 0.06);
    }

    .summary-card span {
      display: block;
      color: #69758d;
      font-size: 14px;
      margin-bottom: 8px;
    }

    .summary-card strong {
      font-size: 28px;
    }

    .issue {
      background: white;
      padding: 22px;
      border-radius: 18px;
      margin-bottom: 16px;
      box-shadow: 0 8px 24px rgba(50, 70, 120, 0.06);
    }

    .issue-top {
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }

    .issue h2 {
      margin: 0 0 8px;
      font-size: 20px;
    }

    .issue p {
      margin: 0 0 14px;
      color: #69758d;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      color: #59667e;
      font-size: 14px;
    }

    .badge {
      display: inline-block;
      padding: 7px 12px;
      border-radius: 999px;
      background: #eef2ff;
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
    }

    .critical {
      background: #ffe7e7;
      color: #b42318;
    }

    .high {
      background: #fff0df;
      color: #b54708;
    }

    .resolved {
      background: #e6f8ee;
      color: #18794e;
    }

    .empty {
      background: white;
      padding: 35px;
      border-radius: 18px;
      text-align: center;
      color: #69758d;
    }

    @media (max-width: 800px) {
      .summary {
        grid-template-columns: repeat(2, 1fr);
      }

      .issue-top {
        flex-direction: column;
      }
    }

    @media (max-width: 500px) {
      .summary {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="header">
      <h1>CampusConnect Issue Report</h1>
      <p>
        Server-rendered campus issue report generated using Express and EJS.
      </p>
    </div>

    <div class="summary">

      <div class="summary-card">
        <span>Total Issues</span>
        <strong><%= stats.total %></strong>
      </div>

      <div class="summary-card">
        <span>Reported</span>
        <strong><%= stats.reported %></strong>
      </div>

      <div class="summary-card">
        <span>In Progress</span>
        <strong><%= stats.inProgress %></strong>
      </div>

      <div class="summary-card">
        <span>Resolved</span>
        <strong><%= stats.resolved %></strong>
      </div>

    </div>

    <% if (issues.length === 0) { %>

      <div class="empty">
        No campus issues found.
      </div>

    <% } else { %>

      <% issues.forEach(issue => { %>

        <div class="issue">

          <div class="issue-top">

            <div>
              <h2>
                <%= issue.title %>
              </h2>

              <p>
                <%= issue.description %>
              </p>
            </div>

            <div>

              <span class="badge">
                <%= issue.status.replaceAll("_", " ") %>
              </span>

              <span class="badge
                <%= issue.priority === 'Critical'
                  ? 'critical'
                  : issue.priority === 'High'
                    ? 'high'
                    : issue.priority === 'Low'
                      ? 'resolved'
                      : ''
                %>">
                <%= issue.priority %>
              </span>

            </div>

          </div>

          <div class="meta">

            <span>
              📍 <%= issue.location %>
            </span>

            <span>
              📁 <%= issue.category %>
            </span>

            <span>
              🎓 <%= issue.department %>
              <%= issue.year %><%= issue.section %>
            </span>

          </div>

        </div>

      <% }) %>

    <% } %>

  </div>

</body>
</html>